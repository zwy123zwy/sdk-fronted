{
  "name": "@web-report-sdk/plugins",
  "version": "0.1.0",
  "description": "采集插件与第三方 APM 双写适配器（C05）",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./error": {
      "source": "./src/error/index.ts",
      "types": "./dist/error/index.d.ts",
      "import": "./dist/error/index.js"
    },
    "./perf": {
      "source": "./src/perf/index.ts",
      "types": "./dist/perf/index.d.ts",
      "import": "./dist/perf/index.js"
    },
    "./route": {
      "source": "./src/route/index.ts",
      "types": "./dist/route/index.d.ts",
      "import": "./dist/route/index.js"
    },
    "./http": {
      "source": "./src/http/index.ts",
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    }
  },
  "dependencies": {
    "@web-report-sdk/core": "workspace:*"
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsup --config scripts/tsup.error.config.mjs && node scripts/check-error-only-bundle.mjs",
    "build:error-only": "tsup --config scripts/tsup.error.config.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check:error-only-bundle": "node scripts/check-error-only-bundle.mjs"
  }
}
