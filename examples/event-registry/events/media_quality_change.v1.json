{
  "event_name": "media_quality_change",
  "schema_version": 1,
  "event_type": "custom",
  "description": "播放器切换清晰度",
  "owner": "team-media",
  "trigger": "用户或自适应策略触发清晰度切换并生效时上报一次",
  "priority": "normal",
  "status": "active",
  "app_ids": [
    "demo-app"
  ],
  "fields": [
    {
      "name": "quality",
      "kind": "dimension",
      "type": "enum",
      "required": true,
      "description": "字段 quality 的占位说明",
      "sensitivity": "none",
      "enum_values": [
        "360p",
        "720p",
        "1080p"
      ]
    },
    {
      "name": "switch_count",
      "kind": "metric",
      "type": "integer",
      "required": false,
      "description": "指标 switch_count 的占位说明",
      "unit": "count",
      "sensitivity": "none",
      "minimum": 0
    }
  ]
}
