          500,
          2500
        ],
        "note": "对照：IndexedDB 写入被推迟 60s，强杀时事务未完成"
      },
      {
        "storage": "opfs-pending",
        "deltas": [
          500,
          2500
        ],
        "note": "对照：OPFS 写入被推迟 60s，强杀时还没写"
