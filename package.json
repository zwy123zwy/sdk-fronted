{
  "name": "web-report-sdk-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck",
    "test": "vitest run --coverage",
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "size": "size-limit",
    "measure:apm-adapter": "node packages/plugins/scripts/measure-apm-adapter.mjs",
    "api:check": "node scripts/api-check.mjs",
    "api:update": "node scripts/api-check.mjs --local",
    "test:contract": "vitest run --project contract",
    "test:e2e": "playwright test",
    "examples:build": "pnpm -r --filter \"./examples/**\" run build",
    "examples:test": "pnpm -r --filter \"./examples/**\" run test",
    "gates:selftest": "node scripts/gate-selftest.mjs",
    "gates": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm size && pnpm api:check && pnpm examples:build && pnpm examples:test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.59.4",
    "@playwright/test": "1.64.0",
    "@size-limit/preset-small-lib": "14.2.0",
    "@types/node": "24.19.1",
    "@vitest/coverage-v8": "5.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "20.14.6",
    "size-limit": "14.2.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
